{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "title": "ShopScale IDP — Platform Unified Observability Dashboard",
  "tags": ["kubernetes", "prometheus", "shopscale"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Cluster CPU Usage (mCores)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) * 1000", "legendFormat": "CPU Usage" }
      ]
    },
    {
      "id": 2,
      "title": "Cluster Memory Usage (MB)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) / 1024 / 1024", "legendFormat": "Memory Working Set" }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Latency (p95 ms)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "P95 Latency" }
      ]
    }
  ]
}
