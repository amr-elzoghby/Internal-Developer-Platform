{
  "claimType": "slack",
  "displayName": "Slack Incident Webhook Alerting",
  "defaultSecretIdentifier": "prod-slack-alerts",
  "parameters": [
    {
      "name": "slackChannel",
      "label": "Slack Workspace Channel",
      "type": "text",
      "default": "#alerts-platform-prod"
    },
    {
      "name": "slackWebhookUrl",
      "label": "Slack Incoming Webhook URL",
      "type": "text",
      "default": "https://slack.workspace.internal/webhook-endpoint"
    },
    {
      "name": "alertEvents",
      "label": "Trigger Events",
      "type": "text",
      "default": "PodCrashLoopBackOff,HighCpuUsage"
    }
  ]
}
